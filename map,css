
/* ==================================================
   POTHOLE VISION - MAP STYLES
================================================== */

.app-navigation {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin: 0 0 22px;
  padding: 7px;
  background: #101827;
  border: 1px solid #334155;
  border-radius: 12px;
}

.nav-tab {
  width: 100%;
  min-height: 45px;
  margin: 0;
  padding: 10px;
  background: transparent;
  color: #cbd5e1;
  border: 1px solid transparent;
  border-radius: 8px;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
}

.nav-tab.active {
  background: #26351e;
  color: #b7f34a;
  border-color: #526b35;
}

/* MAP PANEL */

.map-section {
  display: block !important;
  width: 100%;
  margin-bottom: 25px;
  padding: 22px;
  background: #151f30;
  border: 1px solid #2b394e;
  border-radius: 18px;
  box-shadow: 0 18px 50px #00000030;
  overflow: visible;
}

.map-section[hidden] {
  display: none !important;
}

/* SUMMARY STATISTICS */

.map-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 18px;
}

.map-stat {
  min-width: 0;
  padding: 14px 10px;
  background: #101827;
  border: 1px solid #334155;
  border-radius: 10px;
}

.map-stat span {
  display: block;
  color: #94a3b8;
  font-size: 11px;
  margin-bottom: 5px;
}

.map-stat strong {
  color: #b7f34a;
  font-size: 23px;
}

/* TOOLBAR */

.map-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.map-toolbar p {
  color: #cbd5e1;
  font-size: 13px;
  overflow-wrap: anywhere;
}

.map-toolbar button {
  width: auto;
  min-width: 125px;
  margin: 0;
}

/* LIVE TRACKING CONTROLS */

#liveTrackingControls {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  width: 100%;
  margin-top: 10px;
}

#trackingStatus {
  width: 100%;
  margin: 5px 0;
  color: #94a3b8;
  font-size: 13px;
}

/* ==================================================
   MAP DISPLAY - PROTECTED DIMENSIONS
================================================== */

#inspectionMap {
  display: block !important;
  position: relative !important;

  width: 100% !important;
  height: 480px !important;
  min-height: 480px !important;

  flex: 0 0 480px !important;

  visibility: visible !important;
  opacity: 1 !important;

  overflow: hidden !important;

  border: 1px solid #334155;
  border-radius: 12px;
  background: #26354a;

  z-index: 1;
  isolation: isolate;
}

/* LEAFLET LAYOUT */

#inspectionMap .leaflet-pane {
  z-index: 400;
}

#inspectionMap .leaflet-top,
#inspectionMap .leaflet-bottom {
  z-index: 800;
}

#inspectionMap .leaflet-control {
  z-index: 800;
}

/* MAP LEGEND */

.map-legend {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 14px;
  color: #cbd5e1;
  font-size: 12px;
}

.legend-dot {
  width: 12px;
  height: 12px;
  display: inline-block;
  border-radius: 50%;
  background: #b7f34a;
  border: 2px solid #101827;
  box-shadow: 0 0 0 1px #b7f34a;
}

/* DISCLAIMER */

.map-disclaimer {
  color: #94a3b8;
  font-size: 12px;
  line-height: 1.6;
  margin: 13px 0 22px;
}

/* INSPECTION RECORDS */

.map-records {
  padding: 17px;
  background: #101827;
  border: 1px solid #334155;
  border-radius: 12px;
}

.map-records h3 {
  color: #b7f34a;
  margin: 0 0 14px;
}

.map-record-card {
  padding: 14px 0;
  border-bottom: 1px solid #334155;
}

.map-record-card:last-child {
  border-bottom: none;
}

.record-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.record-card-header strong {
  color: #f8fafc;
  font-size: 14px;
}

.record-count {
  color: #b7f34a;
  font-size: 12px;
  font-weight: bold;
}

.map-record-card p {
  margin: 6px 0;
  color: #cbd5e1;
  font-size: 12px;
  overflow-wrap: anywhere;
}

.record-coordinates {
  color: #94a3b8 !important;
}

/* VIEW ON MAP BUTTON */

.view-record-button {
  width: auto;
  min-height: 38px;
  margin-top: 8px;
  padding: 8px 13px;
  background: #26354a;
  color: #f8fafc;
  border: 1px solid #52627a;
  border-radius: 8px;
  font-size: 12px;
  font-weight: bold;
}

.view-record-button:hover {
  border-color: #b7f34a;
  color: #b7f34a;
}

/* EMPTY RECORDS */

.empty-map-message,
.empty-message {
  color: #94a3b8;
  font-size: 13px;
}

/* ATTRIBUTION */

.map-attribution {
  color: #94a3b8;
  font-size: 11px;
  text-align: center;
  margin-top: 15px;
}

.map-attribution a {
  color: #b7f34a;
}

/* MAP POPUPS */

.leaflet-popup-content-wrapper,
.leaflet-popup-tip {
  background: #151f30;
  color: #f8fafc;
}

.leaflet-popup-content {
  line-height: 1.6;
}

.map-popup strong {
  color: #b7f34a;
}

.map-popup p {
  margin: 5px 0;
}

/* VEHICLE MARKER */

.vehicle-marker-container {
  background: transparent;
  border: none;
}

/* MOBILE */

@media (max-width: 600px) {
  .map-section {
    padding: 15px;
  }

  .map-summary {
    grid-template-columns: 1fr;
  }

  .map-stat {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .map-stat span {
    margin: 0;
  }

  .map-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .map-toolbar button {
    width: 100%;
  }

  #inspectionMap {
    display: block !important;
    width: 100% !important;
    height: 380px !important;
    min-height: 380px !important;
    flex: 0 0 380px !important;
  }

  .record-card-header {
    align-items: flex-start;
  }
}
